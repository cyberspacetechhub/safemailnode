# MongoDB connection string (can share cluster or use its own DB name like /mail-service)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mail-service

# Secret for signing user session JWTs
JWT_SECRET=replace_with_a_strong_jwt_secret_key_at_least_32_chars

# 32+ character secret used to encrypt users' Gmail App Passwords at rest (AES-256-GCM)
ENCRYPTION_SECRET=replace_with_a_32_char_minimum_encryption_secret_key

# Optional: Always grant admin role to this email on registration
ADMIN_EMAIL=admin@example.com
