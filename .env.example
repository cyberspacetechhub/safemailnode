# MongoDB connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mail-service

# Secret for signing user session JWTs (32+ characters)
JWT_SECRET=replace_with_a_strong_jwt_secret_key_at_least_32_chars

# Secret used to encrypt Gmail App Passwords at rest (AES-256-GCM, 32+ characters)
ENCRYPTION_SECRET=replace_with_a_32_char_minimum_encryption_secret_key

# Optional: email that auto-receives admin role + enterprise plan on registration
ADMIN_EMAIL=admin@example.com

# System mailer — used to send verification & password reset emails
# If not set, the system falls back to any active admin MailProject
SYSTEM_GMAIL_USER=system@example.com
SYSTEM_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Public base URL — used to build password reset links in emails
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Upstash Redis — enables distributed rate limiting across serverless instances
# If not set, falls back to in-memory rate limiting (not suitable for multi-instance deployments)
UPSTASH_REDIS_REST_URL=https://<your-upstash-endpoint>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-token>
